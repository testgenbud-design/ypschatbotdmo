# Required for chat answers (server-side only — never exposed to the browser)
OPENROUTER_API_KEY=

# Optional: pick a different model on openrouter.ai (default: openai/gpt-4o-mini)
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional but recommended locally/on Vercel: question logs + callback leads.
# Without it the assistant still works; logging is skipped silently.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
